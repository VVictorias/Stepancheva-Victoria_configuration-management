start: _WS? (declaration _WS)* declaration?
declaration: value _WS? "->" _WS? NAME

?value: NUMBER -> number
      | STRING -> string
      | array
      | expression

array: _LIST _WS? "(" _WS? [items] ")"
items: value _WS? ("," _WS? value _WS?)*

expression: "?{" _WS? operation _WS? "}"
?operation: "+" _WS operand _WS operand -> add
          | "-" _WS operand _WS operand -> subtract
          | "ord" _WS operand            -> char_code
?operand: value
        | NAME -> reference

_LIST.1: /list(?=[ \t\r\n]*\()/
_WS: /[ \t\r\n]+/
NUMBER: /[+-]?(?:[1-9][0-9]*|0)/
STRING: /@"[^"\r\n]*"/
NAME: /[_a-zA-Z]+/
